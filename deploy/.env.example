# Copy to deploy/.env and change every value before exposing AWM to anyone.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AWM_SECRET_KEY=change-me
AWM_ADMIN_TOKEN=change-me
POSTGRES_PASSWORD=change-me
AWM_PUBLIC_URL=http://localhost:8080
AWM_PORT=8080
