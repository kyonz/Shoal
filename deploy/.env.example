# Copy to deploy/.env and change every value before exposing Shoal to anyone.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SHOAL_SECRET_KEY=change-me
SHOAL_ADMIN_TOKEN=change-me
POSTGRES_PASSWORD=change-me
SHOAL_PUBLIC_URL=http://localhost:8080
SHOAL_PORT=8080
# ANTHROPIC_API_KEY=
# E2B_API_KEY=
# SHOAL_IMAGE=ghcr.io/kyonz/ai-workflow-manager:latest
# Drive runs with a Temporal cluster you already run (see docs/temporal.md):
# SHOAL_ORCHESTRATOR=temporal
# SHOAL_TEMPORAL_ADDRESS=temporal-frontend.example.com:7233
# SHOAL_TEMPORAL_NAMESPACE=default
# SHOAL_TEMPORAL_TASK_QUEUE=shoal
# SHOAL_TEMPORAL_API_KEY=

# Instance-wide sign-in and the first instance admins (optional; also add them to the
# api service environment in docker-compose.yaml).
# SHOAL_INSTANCE_OIDC={"issuer": "https://login.example.com", "client_id": "shoal"}
# SHOAL_INSTANCE_OIDC_CLIENT_SECRET=
# SHOAL_INSTANCE_ADMINS=["you@example.com"]
